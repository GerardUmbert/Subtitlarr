# Bazarr connection
BAZARR_BASE_URL=http://192.168.1.10:6767
BAZARR_API_KEY=

# Translation engines
ACTIVE_ENGINE=ollama
FALLBACK_ENGINE=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
# Ollama defaults to 4096 tokens regardless of what the model supports —
# raise this for long subtitle files (a full movie can exceed 4096 tokens
# and get silently truncated). Gemma 3 supports up to 128K; higher values
# use more RAM per request.
OLLAMA_NUM_CTX=8192

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Free tier at build.nvidia.com. Must be a real instructable chat model
# (same requirement as Ollama/Gemini) — NVIDIA also hosts dedicated
# translation-only models (e.g. Riva Translate) which are NOT compatible
# with this app.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

# Scheduling
SCHEDULE_CRON=0 3 * * *
AGE_THRESHOLD_DAYS=14

# Runtime
DB_PATH=/data/subtitlarr.db
RUN_CONCURRENCY=1
LOG_LEVEL=INFO
PORT=8000
