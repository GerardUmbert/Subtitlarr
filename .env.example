# Bazarr connection
BAZARR_BASE_URL=http://192.168.1.10:6767
BAZARR_API_KEY=

# Translation engines
ACTIVE_ENGINE=ollama
FALLBACK_ENGINE=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
# Ollama defaults to 4096 tokens regardless of what the model supports —
# raise this for long subtitle files (a full movie can exceed 4096 tokens
# and get silently truncated). Gemma 3 supports up to 128K; higher values
# use more RAM per request.
OLLAMA_NUM_CTX=8192
# 0 = auto-derive the per-batch dialogue token budget from OLLAMA_NUM_CTX.
# Set explicitly to override with a fixed batch size regardless of context
# window (small models can lose reliable output formatting before they run
# out of raw context).
OLLAMA_BATCH_TOKEN_BUDGET=0

# llama.cpp's own built-in local HTTP server (github.com/ggml-org/llama.cpp)
# — a separate local runtime from Ollama, not another name for it. No web
# UI, no API key, and no model-switching endpoint: the server is started
# with one fixed model already loaded via its own CLI flags.
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_BATCH_TOKEN_BUDGET=400

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Free-tier Gemini enforces a tokens-per-minute (TPM) cap Google doesn't
# publish an exact number for. 4000 failed INSTANTLY live (429 on the very
# first request) — same symptom Groq's API explicitly confirmed as a TPM
# ceiling (see GROQ_BATCH_TOKEN_BUDGET below). Keep this conservative.
GEMINI_BATCH_TOKEN_BUDGET=1800
# Defaults to 1 (sequential) — a TPM cap is shared across every concurrent
# request, so concurrency makes hitting it MORE likely, not less.
GEMINI_CONCURRENT_BATCH_WINDOW=1

# Free tier at build.nvidia.com. Must be a real instructable chat model
# (same requirement as Ollama/Gemini) — NVIDIA also hosts dedicated
# translation-only models (e.g. Riva Translate) which are NOT compatible
# with this app.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
# NVIDIA's cloud model has no local VRAM/GPU constraint, so this can be set
# much higher than OLLAMA_BATCH_TOKEN_BUDGET.
NVIDIA_BATCH_TOKEN_BUDGET=2000

# OpenRouter routes to many different underlying chat models (OpenAI,
# Anthropic, Meta, etc.) via one OpenAI-compatible endpoint. Must be a real
# instructable chat model — see https://openrouter.ai/models for the full
# lineup and model IDs. Get a key at https://openrouter.ai/keys. Defaults to
# a free-tier Gemma model so a fresh install needs no spend to try it.
#
# Free ":free" model variants are capped at 20 requests/minute AND 50
# requests/DAY (1000/day at $10+ purchased credits) — see
# https://openrouter.ai/docs/api_reference/limits. The daily cap makes
# request COUNT matter far more here than for NVIDIA: keep the batch
# budget high (fewer, bigger requests) so one file doesn't burn a big
# chunk of the day's quota by itself.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BATCH_TOKEN_BUDGET=4000

# Groq serves a fixed lineup of models on its own LPU hardware (Llama,
# GPT-OSS, Qwen, etc — no Gemma or DeepSeek). Get a free key at
# https://console.groq.com/keys. llama-3.1-8b-instant confirmed to handle
# Catalan translation and has Groq's most generous documented free-tier
# request limits (30 RPM / 14,400 per day).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Groq ALSO enforces a tokens-per-minute (TPM) cap separate from the
# request-count limits above — confirmed LIVE via Groq's own error body:
# "Request too large for model llama-3.1-8b-instant... on tokens per
# minute (TPM): Limit 6000, Requested 6734" at a 4000-token budget. 1800
# keeps the full round-trip (dialogue + response + system prompt) safely
# under that ceiling.
GROQ_BATCH_TOKEN_BUDGET=1800
# Defaults to 1 (sequential) — the 6000 TPM cap is a single rolling budget
# shared across every concurrent request, so running several batches at
# once makes hitting it MORE likely, not less.
GROQ_CONCURRENT_BATCH_WINDOW=1

# Scheduling — the main translation job
SCHEDULE_CRON=0 3 * * *
AGE_THRESHOLD_DAYS=14
# Max items to translate per day (0 = unlimited). Applies to "Run now" and
# scheduled runs — per-item re-runs always bypass this.
DAILY_TRANSLATION_LIMIT=100
# Brief rest between translations so the GPU isn't pegged non-stop for
# hours (0 = no pause).
PAUSE_BETWEEN_ITEMS_SECONDS=30
# When true, a successful translation is cached locally instead of being
# uploaded to Bazarr immediately — push everything queued in one batch
# later from the Jobs page instead of once per item.
QUEUE_UPLOADS_ENABLED=false

# Scheduling — optional, independent crons for the two Bazarr sync jobs
# (refresh wanted list / pre-fetch source subtitles). Leave blank to keep
# them manual-only via the Jobs page.
SYNC_MEDIA_CRON=40 9 * * *
SYNC_SUBS_CRON=40 9 * * *

# Runtime
DB_PATH=/data/subtitlarr.db
RUN_CONCURRENCY=1
LOG_LEVEL=INFO
PORT=8000
