# Bazarr connection
BAZARR_BASE_URL=http://192.168.1.10:6767
BAZARR_API_KEY=

# Translation engines
ACTIVE_ENGINE=ollama
FALLBACK_ENGINE=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
# Ollama defaults to 4096 tokens regardless of what the model supports —
# raise this for long subtitle files (a full movie can exceed 4096 tokens
# and get silently truncated). Gemma 3 supports up to 128K; higher values
# use more RAM per request.
OLLAMA_NUM_CTX=8192
# 0 = auto-derive the per-batch dialogue token budget from OLLAMA_NUM_CTX.
# Set explicitly to override with a fixed batch size regardless of context
# window (small models can lose reliable output formatting before they run
# out of raw context).
OLLAMA_BATCH_TOKEN_BUDGET=0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Free tier at build.nvidia.com. Must be a real instructable chat model
# (same requirement as Ollama/Gemini) — NVIDIA also hosts dedicated
# translation-only models (e.g. Riva Translate) which are NOT compatible
# with this app.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
# NVIDIA's cloud model has no local VRAM/GPU constraint, so this can be set
# much higher than OLLAMA_BATCH_TOKEN_BUDGET.
NVIDIA_BATCH_TOKEN_BUDGET=2000

# Scheduling — the main translation job
SCHEDULE_CRON=0 3 * * *
AGE_THRESHOLD_DAYS=14
# Max items to translate per day (0 = unlimited). Applies to "Run now" and
# scheduled runs — per-item re-runs always bypass this.
DAILY_TRANSLATION_LIMIT=100
# Brief rest between translations so the GPU isn't pegged non-stop for
# hours (0 = no pause).
PAUSE_BETWEEN_ITEMS_SECONDS=30
# When true, a successful translation is cached locally instead of being
# uploaded to Bazarr immediately — push everything queued in one batch
# later from the Jobs page instead of once per item.
QUEUE_UPLOADS_ENABLED=false

# Scheduling — optional, independent crons for the two Bazarr sync jobs
# (refresh wanted list / pre-fetch source subtitles). Leave blank to keep
# them manual-only via the Jobs page.
SYNC_MEDIA_CRON=40 9 * * *
SYNC_SUBS_CRON=40 9 * * *

# Runtime
DB_PATH=/data/subtitlarr.db
RUN_CONCURRENCY=1
LOG_LEVEL=INFO
PORT=8000
